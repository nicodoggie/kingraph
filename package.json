{
    "name": "@nicodoggie/kingraph",
    "description": "Plots family trees using JavaScript and Graphviz",
    "version": "0.4.0",
    "author": "Rico Sta. Cruz <rico@ricostacruz.com> (http://ricostacruz.com); updated by Alexander Willner (https://github.com/AlexanderWillner/kingraph); updated by Nico Suarez (https://github.com/nicodoggie/kingraph);",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "kingraph": "dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "docs/schema.md"
    ],
    "dependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@viz-js/viz": "^3.31.0",
        "js-yaml": "^5.5.0",
        "meow": "^14.1.0"
    },
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "keywords": [
        "ancestry",
        "family",
        "family tree",
        "genealogy",
        "pedigree"
    ],
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.browser.json",
        "test": "npm run build && vitest run",
        "test:watch": "vitest",
        "test:coverage": "npm run build && vitest run --coverage",
        "lint": "eslint src tests/*.test.ts *.ts *.js",
        "format": "prettier --write src tests/*.test.ts package.json tsconfig*.json *.ts *.js README.md docs/plans/modernization.md docs/getting_started.md .github/workflows/ci.yml",
        "format:check": "prettier --check src tests/*.test.ts package.json tsconfig*.json *.ts *.js README.md docs/plans/modernization.md docs/getting_started.md .github/workflows/ci.yml",
        "prepack": "npm run build"
    }
}
