{
    "name": "@nicodoggie/kingraph",
    "description": "Plots family trees using JavaScript and Graphviz",
    "version": "0.5.0",
    "author": "Rico Sta. Cruz <rico@ricostacruz.com> (http://ricostacruz.com); updated by Alexander Willner (https://github.com/AlexanderWillner/kingraph); updated by Nico Suarez (https://github.com/nicodoggie/kingraph);",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "bin": {
        "kingraph": "dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "docs/schema.md",
        "docs/pictures.md",
        "docs/viewer.md",
        "docs/images/v1",
        "astro",
        "src/viewer.css",
        "src/vite-client.d.ts"
    ],
    "dependencies": {
        "@panzoom/panzoom": "^4.6.2",
        "@resvg/resvg-js": "^2.6.2",
        "@viz-js/viz": "^3.31.0",
        "image-size": "^2.0.4",
        "js-yaml": "^5.5.0",
        "meow": "^14.1.0",
        "zod": "^4.6.7"
    },
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./v1": {
            "browser": {
                "types": "./dist/v1/browser.d.ts",
                "default": "./dist/v1/browser.js"
            },
            "types": "./dist/v1/index.d.ts",
            "import": "./dist/v1/index.js"
        },
        "./v1/schemas": {
            "types": "./dist/v1/schemas.d.ts",
            "import": "./dist/v1/schemas.js"
        },
        "./v2": {
            "browser": {
                "types": "./dist/v2/browser.d.ts",
                "default": "./dist/v2/browser.js"
            },
            "types": "./dist/v2/index.d.ts",
            "import": "./dist/v2/index.js"
        },
        "./v2/schemas": {
            "types": "./dist/v2/schemas.d.ts",
            "import": "./dist/v2/schemas.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./vite/client": {
            "types": "./src/vite-client.d.ts"
        },
        "./viewer": {
            "types": "./dist/viewer.d.ts",
            "import": "./dist/viewer.js"
        },
        "./viewer.css": "./src/viewer.css",
        "./astro": "./astro/KingraphViewer.astro",
        "./package.json": "./package.json"
    },
    "peerDependencies": {
        "astro": "^7.4.0",
        "vite": "^8.3.4"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/mdx": "^8.1.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.0.0",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "astro": "^7.4.2",
        "eslint": "^10.13.0",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "keywords": [
        "ancestry",
        "family",
        "family tree",
        "genealogy",
        "pedigree"
    ],
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "build": "tsc",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.playground.json",
        "test": "npm run build && vitest run",
        "test:watch": "vitest",
        "test:coverage": "npm run build && vitest run --coverage",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "test:browser:install": "playwright install chromium --only-shell",
        "dev": "vite",
        "build:playground": "vite build",
        "lint": "eslint src tests \"playground/**/*.ts\" *.ts *.js",
        "format": "prettier --plugin=prettier-plugin-astro --write \"playground/*.{html,ts,css}\" \"playground/examples/*.yaml\" src \"tests/**/*.ts\" \"astro/**/*.astro\" package.json tsconfig*.json *.ts *.js README.md docs/plans/*.md docs/schema.md docs/pictures.md docs/viewer.md docs/getting_started.md .github/workflows/ci.yml",
        "format:check": "prettier --plugin=prettier-plugin-astro --check \"playground/*.{html,ts,css}\" \"playground/examples/*.yaml\" src \"tests/**/*.ts\" \"astro/**/*.astro\" package.json tsconfig*.json *.ts *.js README.md docs/plans/*.md docs/schema.md docs/pictures.md docs/viewer.md docs/getting_started.md .github/workflows/ci.yml",
        "prepack": "npm run build"
    }
}
